{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keycard.local/schemas/advault-entry.schema.json",
  "title": "KeyCard adVault entry",
  "description": "Locally stored campaign context; contentHash covers the canonical entry content, excluding its receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entryId", "campaignId", "content", "destinationUrl", "relevanceTags", "contentHash", "createdAt", "expiresAt", "storageReceipt"],
  "properties": {
    "entryId": { "$ref": "common.schema.json#/$defs/id" },
    "campaignId": { "$ref": "common.schema.json#/$defs/id" },
    "content": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "destinationUrl": { "$ref": "common.schema.json#/$defs/httpsUrl" },
    "relevanceTags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
    "contentHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expiresAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "storageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "storedAt", "contentHash", "signature"],
      "properties": {
        "providerId": { "$ref": "common.schema.json#/$defs/id" },
        "storedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "contentHash": { "$ref": "common.schema.json#/$defs/sha256" },
        "signature": { "type": "string", "minLength": 1, "contentEncoding": "base64" },
        "retrievalUrl": { "$ref": "common.schema.json#/$defs/httpsUrl" }
      }
    }
  }
}
