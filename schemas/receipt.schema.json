{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keycard.local/schemas/receipt.schema.json",
  "title": "KeyCard paid-call receipt",
  "description": "Public durable call state and direct-payout/refund accounting; excludes signed payload and secret idempotency key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptId", "requestHash", "state", "authorizationMethod", "transaction", "network", "amountLovelace", "payTo", "paymentConfirmed", "payoutStatus", "refundStatus", "refundTransaction"],
  "properties": {
    "receiptId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requestHash": { "$ref": "common.schema.json#/$defs/sha256" },
    "state": { "enum": ["quoted", "verified", "executing", "result_ready", "settling", "completed", "failed", "review"] },
    "authorizationMethod": { "const": "payment" },
    "transaction": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "network": { "const": "cardano:preprod" },
    "amountLovelace": { "$ref": "common.schema.json#/$defs/lovelaceAmount" },
    "payTo": { "$ref": "common.schema.json#/$defs/cardanoAddress" },
    "paymentConfirmed": { "type": "boolean" },
    "payoutStatus": { "enum": ["pending", "paid-directly"] },
    "refundStatus": { "enum": ["none", "due", "paid"] },
    "refundTransaction": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
  }
}
