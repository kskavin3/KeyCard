API_PORT=4020
DATABASE_URL=postgres://keycard:keycard@127.0.0.1:5433/keycard
KEYCARD_PUBLIC_ORIGIN=http://127.0.0.1:4020
KEYCARD_PROVIDER_ID=provider-demo
KEYCARD_PROVIDER_NAME=KeyCard Demo Provider

# Generate each secret locally. Never commit a populated .env file.
KEYCARD_DASHBOARD_PASSWORD=change-this-before-running
KEYCARD_SESSION_SECRET=replace-with-at-least-32-random-bytes
KEYCARD_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Payment settings (Cardano Preprod only).
CARDANO_NETWORK=cardano:preprod
FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org
KEYCARD_PAY_TO=
BLOCKFROST_PROJECT_ID=
FREECRYPTOAPI_API_KEY=

# Ambiguous facilitator timeouts remain pending; never trigger a second payment.
KEYCARD_FACILITATOR_TIMEOUT_MS=20000
KEYCARD_MIN_PAYMENT_LOVELACE=1500000
# Dedicated local agent wallet; never put its mnemonic in environment variables.
KEYCARD_AGENT_WALLET_DIR=.keycard-agent
