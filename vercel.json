{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run vercel:build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": ["schemas/**"],
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ]
}
